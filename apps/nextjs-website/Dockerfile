FROM node:22.19-alpine@sha256:d2166de198f26e17e5a442f537754dd616ab069c47cc57b889310a717e0abbf9
RUN apk add --no-cache g++ make py3-pip libc6-compat
ARG ENVIRONMENT
ENV ENVIRONMENT=${ENVIRONMENT}
ARG PREVIEW_MODE
ENV PREVIEW_MODE=${PREVIEW_MODE}
ARG PREVIEW_TOKEN
ENV PREVIEW_TOKEN=${PREVIEW_TOKEN}
ARG TENANTS_CONFIG
ENV TENANTS_CONFIG=${TENANTS_CONFIG}
WORKDIR /app
COPY package*.json ./
RUN npm install
COPY . .
RUN npm run build
EXPOSE 3000
CMD npm run start
